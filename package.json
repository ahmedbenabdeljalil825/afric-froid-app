{
  "name": "copy-of-afric-froid",
  "private": true,
  "version": "1.5.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:electron": "vite build && electron-builder",
    "preview": "vite preview",
    "db:apply-migrations": "node scripts/apply-migrations.mjs",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "test": "node tests/run-all-verifications.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.0",
    "@capacitor/core": "^8.3.0",
    "@capacitor/push-notifications": "^8.1.2",
    "@capgo/capacitor-updater": "^8.51.20",
    "@supabase/supabase-js": "^2.95.3",
    "@tailwindcss/postcss": "^4.1.18",
    "electron-updater": "^6.8.9",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.564.0",
    "mqtt": "^5.15.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.0",
    "recharts": "^3.7.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.24",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "pg": "^8.14.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-electron": "^1.1.2"
  },
  "build": {
    "appId": "com.africfroid.dashboard.desktop",
